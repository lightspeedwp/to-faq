{
  "name": "to-faq",
  "version": "0.1.0",
  "description": "Tour Operator FAQ turns the Yoast FAQ block into an accessible, collapsible accordion.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --config webpack.config.cjs",
    "build:production": "NODE_ENV=production npm run build",
    "start": "wp-scripts start --config webpack.config.cjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style \"src/**/*.{css,scss}\"",
    "i18n": "wp i18n make-pot . languages/to-faq.pot --domain=to-faq --exclude=node_modules,vendor,src",
    "packages-update": "wp-scripts packages-update",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:version": "node scripts/check-version-sync.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@wordpress/scripts": "^37.0.0",
    "webpack-remove-empty-scripts": "^1.0.0"
  },
  "overrides": {
    "typescript": "~6.0.2"
  }
}
